{
  "name": "@idlapps/t",
  "version": "0.1.2",
  "description": "Lightweight, tree-shakable string utility functions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "concurrently \"tsdown --watch\" \"browser-sync start --config bs-config.cjs\""
  },
  "keywords": [
    "string",
    "utilities",
    "camelcase",
    "truncate",
    "typescript",
    "tree-shakable"
  ],
  "license": "MIT",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mamun-al-abdullah/t.git"
  },
  "homepage": "https://github.com/mamun-al-abdullah/t#readme",
  "bugs": {
    "url": "https://github.com/mamun-al-abdullah/t/issues"
  }
}
